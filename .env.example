# =============================================================================
# Quantum Finance Project — Shared Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Both the SLR and analysis repos load credentials from this file.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual keys
# =============================================================================

# --- Azure OpenAI / Azure AI Foundry ---
AZURE_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_API_KEY=
AZURE_DEPLOYMENT=gpt-5-mini
AZURE_DEPLOYMENTS=gpt-5.1,gpt-5.4
AZURE_API_VERSION=2024-05-01-preview

# Legacy aliases (SLR repo reads these; default to above if unset)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# --- Zotero API ---
ZOTERO_API_KEY=
ZOTERO_GROUP_ID=
ZOTERO_USER_ID=

# --- Optional: external API keys ---
# SCOPUS_API_KEY=
# OPENALEX_API_KEY=
# S2_API_KEY=
# UNPAYWALL_EMAIL=

# --- Project path (optional override) ---
# QUANTUM_FINANCE_PROJECT_ROOT=c:\Users\t-aleixm\Code\quantum-finance
