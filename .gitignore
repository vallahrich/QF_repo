# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets
.env

# Logs
logs/
*.log

# Temporary analysis imports
_analysis_import/

# OpenAlex cache
openalex_cache/

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb

# Compiled thesis PDF (compile locally)
manuscript/*.pdf

# Backup files from screening updates
*.bak_*

# Audit-script backups (e.g., p4_experiments/.../instance.json.bak from
# audit_implementation_type.py). The originals are tracked; backups are
# transient pre-edit snapshots.
*.json.bak

# Writing session working files: ignored by default; selectively un-ignore
# cross-collaborator artefacts (handoffs and similar) so they ship with the repo.
manuscript/working/**
!manuscript/working/
!manuscript/working/*_handoff*.md
!manuscript/working/*_handoff*/
!manuscript/working/.gitkeep

# Offline RAG vector store (regenerable; do not commit)
tools/rag/.chroma/
