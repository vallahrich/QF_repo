# Python cache
__pycache__/
*.pyc

# Extraction outputs (regenerated by pipeline)
output/extractions/*.json
output/tables/*.csv
output/tables/*.md

# Batch API files (large JSONL files)
output/batch/

# Batch logs
output/extractions/_batch_log.json

# Keep output directories
!output/extractions/.gitkeep
!output/tables/.gitkeep
