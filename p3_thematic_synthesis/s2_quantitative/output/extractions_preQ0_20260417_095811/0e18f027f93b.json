      "problem_formulation": {
        "encoding_method": "QUBO",
        "encoding_details": "One binary variable per candidate rebalancing date; x in {0,1}^8 indicates whether to rebalance on each of 8 candidate dates in a window.",
        "objective_function": "minimize x^T Q x, where Q_kk = -lambda1 * g_k + lambda2 * c * n and Q_kl = lambda3 * exp(-|t_k - t_l| / Delta t) for k != l; g_k is the marginal Sharpe gain net of transaction cost.",
        "constraints_handling": "Encoded via QUBO penalty terms; no explicit hard constraints beyond binary schedule variables.",
        "num_binary_variables": 8,
        "problem_hamiltonian": "H_C = sum_i h_i Z_i + sum_{i<j} J_ij Z_i Z_j, obtained from x_i = (1 - Z_i)/2"
      },
