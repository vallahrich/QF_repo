        "dataset_specification": {
          "model": "Rendleman and Bartter (1979) binomial model",
          "initial_underlying_S0": 1,
          "up_down_probabilities": "1/2 each",
          "up_factor": "u = exp((r - sigma^2/2) Delta t + sigma sqrt(Delta t))",
          "down_factor": "d = exp((r - sigma^2/2) Delta t - sigma sqrt(Delta t))",
          "time_grid": "Delta t = T/n",
          "included_time_points": "t_i = i Delta t, i=1,...,n"
        },
        "data_preprocessing_details": "Classically compute the valuation-tree node values S_k(t_i), normalize by M, and map each path to a qubit basis state; for the uniform-superposition experiment, Hadamard gates are used to encode equal path probabilities.",
        "evaluation_methodology": "Single-path circuit evaluations for all computational basis states, then full pricing with 100 histogram data points; each histogram point is estimated from 10^6 circuit shots. The paper also reports 10^7-shot results for the pathwise approximation figures."
