      "problem_formulation": {
        "encoding_method": "amplitude_encoding",
        "encoding_details": "Paths through the valuation tree are encoded in an N-qubit state register; for the binomial model used in the experiment, one qubit per time step is used, so the state register has n qubits. The underlying values are normalized by M=max_{t_i,k} S_k(t_i) and loaded into amplitudes. The positive part is approximated by a gearbox circuit using RY rotations and a Fourier expansion.",
        "objective_function": "Estimate C(0) = E[(S(T) - (1/n) sum_{i=1}^n S(t_i))^+]",
        "constraints_handling": "Positive part implemented approximately via gearbox circuit; no explicit constraints beyond amplitude rescaling and post-processing.",
        "num_binary_variables": null,
        "problem_hamiltonian": null,
        "num_ancilla_qubits": "ceil(log2(n)) for the mean-payoff subcircuit G, plus additional ancilla qubits for the gearbox circuit Gb_D and readout qubits; exact total depends on D and subcircuit decomposition.",
        "objective_function_details": {
          "payoff": "g(x_k)=S(T)-(1/n) sum_i S(t_i)",
          "indicator": "q(x_k)=1{g(x_k)>0}",
          "pricing_estimator": "sum_k f(x_k) g(x_k) q(x_k)"
        }
      },
      "problem_instance": {
        "description": "Rendleman-Bartter binomial model for an Asian option on a valuation tree; all time steps are included in the averaging.",
        "num_assets": 1,
        "time_steps": 5,
