      "experiment_id": "exp_1",
      "description": "End-to-end agentic QAOA portfolio optimization pipeline on a 5-asset real-market instance, including local pre-validation and cloud execution on AWS Tensor Network simulator and QBraid QIR state-vector simulator.",
      "algorithm": {
        "family": "qaoa",
        "variant": "Data-driven QAOA with analytically set angles and agentic orchestration",
        "ansatz": "Hadamard initialization + alternating cost layers (RZ and CX-RZ-CX ZZ terms) and RX mixers",
        "optimizer": null,
        "num_layers": 5,
        "convergence_criteria": null,
        "hyperparameters": {
          "lambda": 0.5,
          "return_rotation_rule": "gamma_i^(l) = l * mu_i * pi",
          "covariance_rotation_rule": "gamma_ij^(l) = l * C_ij * pi / 2",
          "mixer_rotation_rule": "beta_i^(l) = l * 0.4 * pi / p",
          "p": 5,
          "n": 5,
          "shots_local": 1000,
          "shots_aws_tn1": 1000,
          "shots_qbraid_qir": 2000,
          "backend_profile": "local simulator profile (n=5, p=5)",
          "quality_gate_threshold": "normalized mean > 0",
          "polling_interval_seconds": 5,
          "polling_max_attempts": 60,
          "polling_timeout_minutes": 5,
          "maturity_policy_levels": {
