      "problem_formulation": {
        "encoding_method": "basis_encoding",
        "objective_function": "min lambda * x^T C x - (1 - lambda) * mu^T x with lambda = 0.5",
        "constraints_handling": "Unconstrained binary selection; no fixed cardinality constraint; equal-weight allocation used only in classical evaluation of sampled bitstrings",
        "num_binary_variables": 5,
        "problem_hamiltonian": "QUBO with Q_ij = lambda * C_ij for i != j and q_i = lambda * C_ii - (1 - lambda) * mu_i"
