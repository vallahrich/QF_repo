        "time_steps": "20 synthetic snapshots; 50-200 monthly social snapshots; 30-100 biological time steps; ~500 daily financial snapshots",
        "num_features": null,
        "dataset_size": "Synthetic: 5,000-10,000 nodes and 20,000-50,000 edges; Social: 10,000-50,000 nodes and up to 200,000 edges per snapshot; Biological: 2,000-20,000 nodes; Financial: 500-2,000 nodes",
        "data_type": "public_benchmark",
        "dataset_name": "LFR, SBM, Enron, DBLP, PPI, Brain fMRI, Stock, Crypto",
        "dataset_specification": {
          "description": "Synthetic graphs are undirected and unweighted with isolated-node removal and community-size normalization. Social networks are directed and unweighted with timestamp alignment and duplicate-interaction removal. Biological networks are weighted undirected with edge-weight normalization and thresholding at 0.05. Financial correlation networks use rolling-window Pearson correlation, Fisher-z transformation, and sparsification at the 0.1 quantile."
        },
        "data_preprocessing_details": "Remove isolated nodes; normalize community size distribution; align timestamps; remove duplicate interactions; normalize edge weights; prune low-confidence interactions with threshold 0.05; compute rolling-window Pearson correlation; apply Fisher-z transformation; sparsify at 0.1 quantile.",
