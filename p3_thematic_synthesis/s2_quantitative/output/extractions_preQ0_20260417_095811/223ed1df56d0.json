      "problem_formulation": {
        "encoding_method": "basis_encoding",
        "encoding_details": "One binary variable x_l per DR participant; x_l = 1 means request DR from participant l, x_l = 0 otherwise. Fermionic mapping uses one fermionic occupation number n_l per binary variable.",
        "objective_function": "Minimize E_{T,x} = (1/N_T) sum_{t in T} [ sum_{l,l'} sigma_{t,l,l'} x_l x_{l'} + (sum_l E[p_{t,l}] x_l - P'_{t,proc})^2 ] subject to sum_l x_l = M_T.",
        "constraints_handling": "Hard constraint sum_l x_l = M_T enforced by fixed-particle-number subspace; procurement inequality constraint Pt,proc <= sum_l E[p_{t,l}] x_l <= Pt,proc + delta is relaxed into a quadratic penalty term using P'_t,proc = Pt,proc + delta/2.",
        "num_binary_variables": 20,
        "problem_hamiltonian": "H_p,T = sum_{l,l'} sigma_{T,l,l'} n_l n_{l'} + (1/N_T) sum_{t in T} (P_t - P'_{t,proc})^2, with P_t = sum_l E[p_{t,l}] n_l."
      },
      "problem_instance": {
        "description": "Electric power demand portfolio optimization / negawatt trading using historical residential electricity usage as negawatt supply estimates.",
