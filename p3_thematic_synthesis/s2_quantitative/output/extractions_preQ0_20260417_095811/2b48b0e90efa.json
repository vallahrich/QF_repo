    {
      "experiment_id": "exp_1",
      "description": "MOVCO-VQE on randomly generated Cash Management Problem instances with 2 cash points over 2, 3, and 4 days, using a hardware-efficient one-layer ansatz and NSGA-II multiobjective optimization.",
      "algorithm": {
        "family": "vqe",
        "variant": "MOVCO-VQE (multiobjective variational constrained optimizer with VQE)",
        "ansatz": "hardware-efficient ansatz with parameterized single-qubit Ry rotations and nearest-neighbor CZ entangling gates",
        "optimizer": "NSGA-II genetic algorithm",
        "num_layers": 1,
        "convergence_criteria": "run for up to 200-400 generations in the reported plots; no explicit stopping criterion beyond fixed generations",
        "hyperparameters": {
          "population_size": 10,
          "offspring_population_size": 10,
          "shots_per_evaluation": 8192,
          "genetic_operators": [
            "binary tournament selection",
            "simulated binary crossover",
            "polynomial mutation"
          ]
        }
      },
      "problem_formulation": {
        "encoding_method": "basis_encoding",
        "objective_function": "Minimize cash transaction cost C(z) while maximizing constraint satisfaction P(θ) and minimizing restricted energy E(θ) over feasible samples only.",
        "constraints_handling": "Multiobjective optimization with feasibility score P(θ) and restricted energy E(θ); no penalty terms.",
        "num_binary_variables": 8,
        "problem_hamiltonian": "C(z) = k0 * sum_{c in [0,C)} [1 - δ(3/2 + 1/2 z_{c,0} + 2 z_{c,1} + P_{c,0})] + sum_{c in [0,C), t in [1,D)} k_c [1 - δ(3/2 + 1/2 z_{c,t,0} + 2 z_{c,t,1} - P_{c,t} + P_{c,t-1})]"
      },
      "problem_instance": {
        "description": "Cash Management Problem with 2 cash points and temporal horizons of 2, 3, and 4 days; 120 random instances per setting.",
        "num_assets": null,
