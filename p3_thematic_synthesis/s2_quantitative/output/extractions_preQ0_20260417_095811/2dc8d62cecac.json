          "parameter_setting_methods": [
            "Ref. [9] baseline",
            "method (i): gamma* = gamma_inf / sqrt((D-1)/|E| * sum w_uv^2)",
            "method (ii): gamma* = gamma_inf / sqrt((1/|E|) * sum w_uv^2) * arctan(1/sqrt(D-1))"
