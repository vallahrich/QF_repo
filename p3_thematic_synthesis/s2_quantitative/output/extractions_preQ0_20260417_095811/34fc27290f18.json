          "shots_sampler_larger_sizes": 100000
        }
      },
      "problem_formulation": {
        "encoding_method": "QUBO",
        "objective_function": "Minimize O(n) = -F(n) + γ R(n) + C(n), with γ = 1000; F(n) = n^T p_t, R(n) = n^T Σ_t n, C(n) = v Σ_t |w_t - w_{t-1}|, and QUBO approximation using quadratic penalty terms",
