      "experiment_id": "exp_1",
      "description": "Noiseless QAOA portfolio optimization on five small binary-encoded portfolio instances (2, 2, 3, 4, and 5 qubits) using Qiskit Statevector simulation, with performance tracked across QAOA depths p=1 to 21.",
      "algorithm": {
        "family": "qaoa",
        "variant": "vanilla QAOA for portfolio optimization",
        "ansatz": null,
        "optimizer": "COBYLA",
        "num_layers": 21,
        "convergence_criteria": "20 simulations per p value for p = 1..21; performance summarized by mean of five smallest energies and mean of five largest optimal-solution probabilities",
        "hyperparameters": {
          "risk_preference_factor_b": 0.5,
          "penalty_factor_lambda": "2N",
          "shots_per_qaoa_run": 8192,
          "runs_per_layer": 20,
          "layer_range": "1..21",
          "maxiter": 1000,
          "rhobeg": 1.0
        }
      },
      "problem_formulation": {
        "encoding_method": "QUBO",
        "objective_function": "C(x) = b x^T Σ x - μ^T x + λ(B - 1^T x)^2",
        "constraints_handling": "Budget constraint enforced via quadratic penalty term λ(B - 1^T x)^2; binary weights x ∈ {0,1}^N",
        "num_binary_variables": null,
        "problem_hamiltonian": "H0 = -∑_i X_i; Hf = ∑_{i,j} Q_ij Z_i ⊗ Z_j + ∑_i L_i Z_i + C"
      },
