  "summary": "",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Hybrid quantum-classical fraud detection classifier on the Kaggle credit card fraud dataset, where a variational quantum layer replaces one dense layer in an otherwise matched neural network and is evaluated across 10- and 15-qubit settings with varying quantum depth and priority-entanglement budgets.",
      "algorithm": {
        "family": "hybrid",
        "variant": "Variational quantum circuit classifier with data re-uploading and data-driven priority entanglement",
        "ansatz": "Angle embedding + CNOT priority pairs + strongly entangling layer (SEL)",
        "optimizer": "Adam",
        "num_layers": 1,
        "convergence_criteria": "Fixed training for 10 epochs",
        "hyperparameters": {
          "qubits": [
            10,
            15
          ],
          "quantum_layers": [
            1,
            3,
            5
          ],
          "priority_pairs": [
            0,
            10,
            30,
            80,
            135
          ],
          "learning_rate": 0.001,
          "batch_size": 32,
          "epochs": 10,
          "decision_threshold": 0.3,
          "class_weight_positive": "N0/N1",
          "reuploading_chunks": {
            "10_qubits": 3,
            "15_qubits": 2
          },
          "feature_count": 30,
          "train_validation_test_split": "50/25/25",
          "random_state": 42,
          "optimizer_interface": "PyTorch backprop through PennyLane TorchLayer",
          "device": "default.qubit"
        },
        "parameter_initialization": null,
        "optimizer_settings": {
          "learning_rate": 0.001,
          "batch_size": 32,
          "max_epochs": 10,
          "diff_method": "backprop"
        }
      },
      "problem_formulation": {
        "encoding_method": "angle_encoding",
        "encoding_details": "30 PCA-like features are reordered by train-only Pearson correlation, then re-uploaded in chunks of size Q across Q qubits using RY rotations with zero-padding if needed; features are mapped to qubits by chunk and position.",
        "objective_function": "Binary cross-entropy with logits: L = -w+ y log σ(h) - (1-y) log(1-σ(h)), with w+ = N0/N1",
        "constraints_handling": "Class imbalance handled by positive-class weighting in the loss; no explicit quantum constraints beyond fixed entanglement budget and chunk-wise realizability of priority pairs",
        "num_binary_variables": null,
        "problem_hamiltonian": null,
        "num_ancilla_qubits": null
      },
      "problem_instance": {
        "description": "Credit card fraud detection on the Kaggle benchmark with extreme class imbalance; all fraud cases retained and majority class downsampled.",
        "num_assets": null,
        "time_steps": null,
        "num_features": 30,
        "dataset_size": 10492,
        "data_type": "public_benchmark",
        "dataset_name": "Kaggle Credit Card Fraud Detection",
        "dataset_specification": {
          "description": "European card transactions over two days in 2013; 284,807 total transactions originally, with 492 fraud cases. Majority class downsampled to 10,000 legitimate transactions while preserving all 492 frauds. Added hour-of-day feature from Time via (Time/3600) mod 24, then dropped Time. StandardScaler fit on training set only. Stratified 50/25/25 train/validation/test split with random_state=42."
        },
        "data_preprocessing_details": "PCA-like features already present; majority-class downsampling; hour-of-day feature engineering from Time; drop Time; train-only StandardScaler; train-only Pearson correlation matrix used to reorder features and select priority pairs; identical feature order applied to train/validation/test.",
        "evaluation_methodology": "100 randomized runs for 10-qubit configurations and 20 randomized runs for 15-qubit configurations; metrics reported as mean ± standard deviation on holdout test set; ablations over qubit count, quantum depth, and priority-pair budget."
      },
      "quantum_resources": {
        "num_qubits": [
