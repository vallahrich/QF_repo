      "description": "Hybrid iterative adiabatic optimization algorithm tested on 64-qubit maximum independent set instances with highly degenerate local minima, using repeated short anneals and QMC-based sampling to update single-qubit tunneling amplitudes until the perturbative anticrossing is removed.",
      "algorithm": {
        "family": "hybrid",
        "variant": "iterative adiabatic quantum optimization with adaptive single-qubit tunneling penalties",
        "ansatz": null,
        "optimizer": null,
        "num_layers": null,
        "convergence_criteria": "Stop when a sufficient result is returned; in simulations, instances were considered solved when either the adiabatic time ta < 16 µs or the probability of states descending to the global minimum exceeded 0.005",
        "hyperparameters": {
          "r": 500,
          "tf": "0.08 µs",
          "beta_schedule": "beta = 1/(kappa + 1)",
          "feasible_range_delta_i": "[1/4, 8]",
          "initial_delta_i": 1,
          "success_threshold_ta": "16 µs",
          "success_threshold_global_minimum_probability": 0.005
        },
        "parameter_initialization": "Initialize all tunneling amplitudes Delta_i = 1",
        "optimizer_settings": {
          "update_rule": "Delta_i,new = Delta_i,old^(1-beta) * mu_i^(-beta)",
          "rescaling": "Rescale all Delta_i values to remain within [1/4, 8]",
          "sampling_per_iteration": 500
        }
      },
      "problem_formulation": {
        "encoding_method": "QUBO",
        "encoding_details": "Binary variable x_i assigned to each graph node; x_i = 1 indicates inclusion in the independent set",
        "objective_function": "E(x) = -sum_i x_i + c * sum_(i,j in E) x_i x_j, with c > 1",
        "constraints_handling": "Constraint enforced via penalty term c * sum x_i x_j; feasible independent sets correspond to zero penalty",
        "num_binary_variables": 64,
        "problem_hamiltonian": "HP = sum_i h_i sigma_z^i + sum_(i,j) J_ij sigma_z^i sigma_z^j, with h_i = (-n_i c + 2)/4 and J_ij = c/4 for edges"
      },
