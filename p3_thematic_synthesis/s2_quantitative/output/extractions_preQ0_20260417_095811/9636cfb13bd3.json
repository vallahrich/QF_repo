        "encoding_method": "QUBO",
        "encoding_details": "3 binary asset variables with slack variables mapped to dedicated ancilla qubits; inequality constraints converted to equalities via slack variables",
        "objective_function": "Minimize ω^T Σ ω − λ μ^T ω subject to 1^T ω = 1 and ω_i ≤ α_i, reformulated with penalty β∑_i(ω_i − α_i + s_i)^2",
        "constraints_handling": "Slack-variable penalty internalized in the Hamiltonian; each slack variable represented by an ancilla qubit; compared against standard penalty-only QAOA",
        "num_binary_variables": 3,
        "problem_hamiltonian": "H = ∑_{i,j} Σ_{ij} Z_i Z_j / 4 − ∑_i [ (∑_j Σ_{ij})/2 − λ μ_i / 2 + β(1/2 + s_i − α_i) ] Z_i + ∑_i β_i Z_i^2 / 2 − ∑_i [ (∑_j Σ_{ij})/4 − λ μ_i / 2 − β((s_i − α_i)^2 + (s_i − α_i) + 1/4) ]",
