      "problem_formulation": {
        "encoding_method": "basis_encoding",
        "encoding_details": "Each loanee i is represented by M binary qubits/variables x_{i,j}; action j is taken if x_{i,j}=1. The QAOA uses up to ν×M qubits per subgraph, with one qubit per loanee-action pair.",
        "objective_function": "Y = (1−ϵ) Σ_i Σ_j h_{i,j} x_{i,j} + ϵ Σ_{⟨i,i'⟩} A_{i,i'} (1−x_{i,1})(1−x_{i',1})",
        "constraints_handling": "Local one-hot constraint Σ_j x_{i,j}=1 enforced by number-preserving QAOA Hamiltonians; LLP global constraint Σ_i Σ_j l_{i,j} x_{i,j} ≤ L handled by post-optimization Greedy Provision Reduction (soft constraint in practice).",
        "num_binary_variables": 3000,
        "problem_hamiltonian": "H_A = −(1−ϵ) Σ_i Σ_j h_{i,j} n̂_{i,j} − ϵ Σ_{⟨i,i'⟩} A_{i,i'} (1−n̂_{i,1})(1−n̂_{i',1}); H_B = −(J/2) Σ_i [Σ_j (X̂_{i,j} X̂_{i,j+1} + Ŷ_{i,j+1} Ŷ_{i,j})] with periodic boundary conditions"
      },
