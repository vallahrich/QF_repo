      "problem_formulation": {
        "encoding_method": "QUBO",
        "encoding_details": "Binary variable x_vc indicates whether node v is assigned to community c; number of binary variables equals number of nodes multiplied by number of communities. The QUBO is transformed to an Ising model via s_vc = 2x_vc - 1.",
        "objective_function": "min_x - (1/2m) * sum_c sum_v sum_w (A_vw - k_v k_w / (2m)) x_vc x_wc + P * sum_v (sum_c x_vc - 1)^2, where modularity M = (1/2m) sum_v,w (A_vw - k_v k_w / (2m)) delta(C_v, C_w).",
        "constraints_handling": "Penalty term P * sum_v (sum_c x_vc - 1)^2 enforces one community assignment per node.",
        "num_binary_variables": 1232,
        "problem_hamiltonian": "Ising energy E(s) = -sum_{i<j} J_ij s_i s_j - sum_i h_i s_i, obtained from the QUBO via s_vc = 2x_vc - 1.",
        "num_ancilla_qubits": null
      },
