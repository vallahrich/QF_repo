      "experiment_id": "exp_1",
      "description": "CVaR-VQE peptide-folding experiment on 50 seven-amino-acid peptides using a coarse-grained tetrahedral lattice model, evaluated on a local quantum simulator/Amazon Braket statevector simulator with 100 optimization iterations and 500,000 shots per iteration.",
      "algorithm": {
        "family": "vqe",
        "variant": "CVaR-VQE for peptide folding",
        "ansatz": "parameterized quantum circuit with Hadamard, conditional rotational gates, CNOT gates, and Rx/Ry/Rz rotation layers",
        "optimizer": "surrogateopt",
        "num_layers": 2,
        "convergence_criteria": "100 iterations per peptide",
        "hyperparameters": {
          "num_iterations": 100,
          "shots_per_iteration": 500000,
          "cvar_alpha": 0.05,
          "cvar_alpha_noise_free": 0.025,
          "rotation_gates": [
            "Rx",
            "Ry",
            "Rz"
          ],
          "conditional_rotation_gates": "dual conditional rotational gates",
          "qubit_encoding": "dense encoding",
          "interaction_terms": "1-NN only",
          "penalty_terms": "used for invalid configurations and backtracking",
          "optimizer_type": "genetic method in original work; surrogateopt used here"
        },
        "parameter_initialization": "Rotation angles were determined via a genetic method in the original work; surrogateopt used in this study",
        "optimizer_settings": {
          "max_iterations": 100,
          "parameter_bounds": [
            "-pi",
            "pi"
          ]
        }
      },
      "problem_formulation": {
        "encoding_method": "basis_encoding",
        "encoding_details": "7 qubits represent the 7 amino acids; 2 interaction qubits are used; the paper also states a helper qubit is included but not measured, yielding 9 total qubits for the full model",
        "objective_function": "Minimize the exact Hamiltonian energy of the peptide fold; CVaR objective is the weighted average of the lower-energy tail of sampled bitstrings",
        "constraints_handling": "Penalty terms enforce valid turns, prevent same-axis consecutive turns, prevent backtracking/overlap, and impose chirality constraints",
        "num_binary_variables": 12,
        "problem_hamiltonian": "Exact Hamiltonian with 1-NN contact terms plus penalty terms H_back and H_chirality; contact energies taken from a lookup table",
        "num_ancilla_qubits": 1
      },
      "problem_instance": {
