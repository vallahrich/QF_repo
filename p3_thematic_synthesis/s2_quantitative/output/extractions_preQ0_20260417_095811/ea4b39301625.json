      "problem_formulation": {
        "encoding_method": "QUBO",
        "encoding_details": "Binary buy/hold encoding with one binary variable per asset; portfolio weights w_i are replaced by x_i ∈ {0,1}, then mapped to Ising spins z_i ∈ {-1,1} via x_i = (1 - z_i)/2",
        "objective_function": "Minimize Markowitz objective C(w) = (1 - λ) w Σ w^T - λ μ · w, converted to QUBO C(x) = Σ_i b_i x_i + Σ_{i,j} A_ij x_i x_j and then to Ising C(z) = Σ_i d_i z_i + Σ_{i,j} Q_ij z_i z_j; CVaR is used as the optimization target over measured energies",
        "constraints_handling": "Budget constraint B enforced in the discrete buy/hold formulation; no explicit penalty term details reported",
        "num_binary_variables": 10,
        "problem_hamiltonian": "H_C = Σ_i d_i σ_i^Z + Σ_{i,j} Q_ij σ_i^Z ⊗ σ_j^Z",
        "num_ancilla_qubits": 0
      },
