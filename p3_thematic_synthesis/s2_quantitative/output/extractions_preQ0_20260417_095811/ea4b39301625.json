      "experiment_id": "exp_1",
      "description": "CVaR-QAOA and improved CVaR-QAOA portfolio optimization experiments on real Nasdaq stock data, evaluated on problem sizes of 10, 12, 14, and 16 assets with p=1 and p=2 (results reported mainly for p=1).",
      "algorithm": {
        "family": "qaoa",
        "variant": "CVaR-QAOA and improved CVaR-QAOA with an added problem-agnostic ZZ entangling layer and extra X-mixer layer",
        "ansatz": "Standard QAOA p-layer ansatz plus an additional sequential ZZ layer over n-1 nearest-neighbor couplings and one extra global X-mixer layer",
        "optimizer": "COBYLA",
        "num_layers": 1,
        "convergence_criteria": "Iterative classical optimization until the cost value converges to the optimal value; reported convergence iterations in Table 2",
        "hyperparameters": {
          "alpha": [
            0.01,
