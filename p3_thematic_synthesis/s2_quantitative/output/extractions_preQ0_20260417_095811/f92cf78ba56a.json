        }
      },
      "problem_formulation": {
        "encoding_method": "basis_encoding",
        "encoding_details": "7 qubits represent the 7 amino acids; 2 interaction qubits are used; paper also states 9 qubits total to model a fold, with 7 for setup and 2 for interaction; configuration set to '0011q1qqqqqq' in the sparse encoding description",
        "objective_function": "Minimize the expected energy of the exact Hamiltonian; CVaR objective computed from the tail of the energy distribution after sorting observed bitstrings by energy",
        "constraints_handling": "Penalty terms with large positive lambda for invalid turn configurations, backtracking prevention via lambda_back, and chirality constraints Hcr; valid initialization and number-conserving gates also used where possible",
        "num_binary_variables": null,
        "problem_hamiltonian": "Exact Hamiltonian with 1-NN interaction term H(1), geometric constraint term Hgc, backtracking penalty term lambda_back T(i,i+1), and chirality constraint Hcr",
