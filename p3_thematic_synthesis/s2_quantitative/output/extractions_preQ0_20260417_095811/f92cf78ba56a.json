          "rotation_gates": [
            "RX",
            "RY",
            "RZ"
          ],
          "conditional_rotation_gates": "dual conditional rotational gates",
          "lattice": "regular tetrahedral lattice",
          "interaction_model": "1-NN only",
          "penalty_terms": true
        },
        "parameter_initialization": "Not reported",
        "optimizer_settings": {
