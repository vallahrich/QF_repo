  "has_quantitative_results": true,
  "summary": "The paper proposes HQRNN-FD, a gate-based hybrid quantum-classical fraud detector using a 2-layer VQC with 6 qubits, dual-angle encoding, data reuploading, and RNN/self-attention. It reports accuracy 0.9715, precision 0.8486, recall 0.9601, and F1-score 0.9009 on the fraud class, with average qubit-scaling accuracy improving from 0.9631 (2 qubits) to 0.9702 (4 qubits) and 0.9721 (6 qubits).",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Hybrid quantum recurrent neural network for fraud detection using a variational quantum circuit (VQC) with angle encoding, data reuploading, hierarchical entanglement, and an RNN with self-attention; evaluated on a public fraud transaction dataset with SMOTE preprocessing, noise robustness tests, and qubit-scaling experiments.",
      "algorithm": {
        "family": "other-gate-based",
        "variant": "HQRNN-FD (hybrid quantum recurrent neural network with self-attention)",
        "ansatz": "Layered VQC with Hadamard initialization, dual-angle encoding (Ry/Rz), data reuploading, local ring CNOT entanglement, global CNOT entanglement, and U3 parameterized rotations",
