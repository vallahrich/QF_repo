  "has_quantitative_results": true,
  "summary": "The paper studies a simulator-only variational quantum classifier for credit-card fraud detection on the Kaggle benchmark, using 10 or 15 qubits with data re-uploading and priority entanglement. The best reported hybrid result is PR-AUC 0.9229±0.006 and recall 0.9301±0.011 at 15 qubits, 1 quantum layer, and 10 priority pairs, compared with the best classical PR-AUC of 0.9150±0.014 and best classical recall of 0.8832±0.014.",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Hybrid quantum-classical fraud detection classifier on the Kaggle credit card fraud benchmark, comparing a variational quantum circuit layer against a matched classical dense layer under identical preprocessing and parameter budget; evaluated at 10 and 15 qubits with ablations over quantum depth and priority-entanglement budget.",
      "algorithm": {
        "family": "other-gate-based",
        "variant": "Variational quantum circuit (VQC) hybrid classifier with data re-uploading and data-driven priority entanglement; compared against a capacity-matched classical neural network",
        "ansatz": "Angle embedding + CNOT priority pairs + strongly entangling layer (SEL) + Pauli-Z readout",
        "optimizer": "Adam",
        "num_layers": null,
        "convergence_criteria": "Fixed training for 10 epochs",
        "hyperparameters": {
          "qubit_count_options": [
