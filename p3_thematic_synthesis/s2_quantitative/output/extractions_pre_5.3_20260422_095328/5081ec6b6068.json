  "has_quantitative_results": true,
  "summary": "Large-scale empirical comparison of 10 classical, pure quantum, hybrid quantum-classical, and transformer models for Automated Market Maker (AMM)/DeFi trading across BTCUSDC, ETHUSDC, USDCUSDT over 252 trading days (2024). Targets are binary rebalancing/trade signals. Pure quantum models (VQE Classifier, QNN, QSVM) use angle encoding on 6-8 features; hybrid models (QASA Hybrid, QASA Sequence, QuantumRWKV) use 12 mixed features; classical ML (Random Forest, Gradient Boosting, Logistic Regression) use 50-80 features. Main finding: hybrid QASA Sequence achieves highest return 13.99%, Sharpe 1.76, Calmar 6.51; classical Random Forest and Gradient Boosting achieve 13.16% and 12.31% return (Sharpe 1.68 each); pure quantum models significantly underperform (3.00%-4.77% return, Sharpe 0.79-0.87). Hybrid quantum-classical designs recommended for practical DeFi trading; pure quantum models not recommended at current maturity.",
  "experiments": [
    {
      "experiment_id": "exp_1_qasa_sequence",
      "description": "QASA Sequence hybrid quantum-classical model: LSTM temporal layer feeding a quantum adaptive self-attention layer for AMM/DeFi trading signal classification. Backtested on BTCUSDC, ETHUSDC, USDCUSDT over Jan 1 2024 - Jan 1 2025 (252 trading days). 12 features with mixed classical/quantum processing; time-series split 70/15/15 train/val/test; 5 runs per model.",
      "algorithm": {
        "family": "hybrid",
        "variant": "QASA Sequence (Quantum Adaptive Self-Attention Sequence): LSTM + quantum adaptive self-attention hybrid architecture (ref [3] Chen & Kuo 2025 arXiv:2504.05336)",
        "ansatz": "Quantum adaptive self-attention layer; LSTM handles sequence processing, quantum layer processes LSTM outputs for nonlinear pattern capture",
        "optimizer": "not_specified",
        "hyperparameters": {
          "features": 12,
          "preprocessing": "mixed classical/quantum",
