  "has_quantitative_results": true,
  "summary": "The paper proposes a gate-based quantum autoencoder fraud detector (QAE-FD) using 4 qubits, 4 ansatz layers, and 50 training epochs on the ULB credit card fraud dataset (284,807 transactions, 30 features). The best reported noise-free results at threshold 0.7 are precision 0.379, recall 0.897, accuracy 0.990, F1-score 0.533, G-mean 0.946, and AUC 0.947; in the noisy FakeCairo simulation, the corresponding values are precision 0.480, recall 0.765, accuracy 0.990, F1-score 0.590, G-mean 0.874, and AUC 0.881.",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Quantum autoencoder-based fraud detection (QAE-FD) on a public credit card fraud dataset, evaluated in both noise-free simulation and a noisy IBM fake backend, with threshold sensitivity analysis and circuit-depth ablation.",
      "algorithm": {
        "family": "other-gate-based",
        "variant": "Quantum AutoEncoder-based Fraud Detection (QAE-FD) using only the encoder part of a QAE",
