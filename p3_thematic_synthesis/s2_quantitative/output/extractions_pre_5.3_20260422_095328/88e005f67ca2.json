  "has_quantitative_results": true,
  "summary": "The paper benchmarks a hybrid QTCNN on JPX Tokyo Stock Exchange data and reports an out-of-sample Sharpe ratio of 0.538 ± 0.042, outperforming the best classical baseline Transformer at 0.313 ± 0.036. In the qubit-scaling study, QTCNN improves from 0.347 at 4 qubits to 0.551 at 10 qubits before slightly dropping to 0.529 at 12 qubits; the noisy-simulation study shows degradation under depolarizing and amplitude-damping noise but QTCNN remains above the classical Transformer baseline for moderate error rates.",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Hybrid quantum-classical temporal convolutional neural network (QTCNN) for cross-sectional equity return prediction on JPX Tokyo Stock Exchange data, evaluated against classical and other quantum baselines; includes ablation, qubit-scaling, and noise-resilience studies for the same model family.",
      "algorithm": {
        "family": "hybrid",
        "variant": "Quantum Temporal Convolutional Neural Network (QTCNN) with temporal CNN encoder + parameter-shared quantum convolutional layers",
        "ansatz": "AngleEmbedding (Ry) + hierarchical quantum convolution/pooling with CNOT ring / nearest-neighbor entangling structure; 6-parameter convolutional unit; BasicEntanglerLayers used in QNN baseline",
        "optimizer": "AdamW",
        "num_layers": null,
        "convergence_criteria": "50 training epochs",
        "hyperparameters": {
          "qubits_default": 8,
          "sequence_length": 20,
          "temporal_encoder": "1D convolutions + global average pooling + MLP",
