        }
      },
      "problem_formulation": {
        "encoding_method": "angle_encoding",
        "encoding_details": "Each chunk is mapped to a shallow quantum circuit; the resulting 2x2 density matrix is converted to a Bloch vector. Sentence representation is formed by uniform convex combination of valid chunk Bloch vectors. CCG types determine circuit wiring and type embeddings are used in the sequence model.",
        "objective_function": "Three-way cross-entropy over class probabilities derived from similarity between sentence density matrix and class label density matrices; evaluation uses macro-F1 and accuracy.",
        "constraints_handling": "Chunks with identity type output are excluded; sentences with no valid chunks are skipped during training; class-specific thresholds are tuned on the dev set.",
        "num_binary_variables": null,
        "problem_hamiltonian": null,
        "num_ancilla_qubits": null
      },
