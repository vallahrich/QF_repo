  "has_quantitative_results": true,
  "summary": "The paper studies a QDisCoCirc-inspired chunked diagram-to-circuit QNLP model for 3-class financial sentiment classification on Financial PhraseBank (2,263 remaining examples after preprocessing). The main gate-based model achieves 0.696 test accuracy and 0.551 macro-F1, while the shallow Transformer over Bloch vectors improves to 0.6916 accuracy and 0.5857 macro-F1; both remain well below the FinBERT baseline at 0.97 accuracy and 0.95 macro-F1.",
  "experiments": [
    {
      "experiment_id": "exp_1",
      "description": "Classical-simulation evaluation of a QDisCoCirc-inspired chunked diagram-to-circuit QNLP model for three-class financial sentiment classification on Financial PhraseBank, using IQP-ansatz chunk circuits and mean-pooled Bloch vectors as the baseline representation.",
      "algorithm": {
        "family": "other-gate-based",
        "variant": "QDisCoCirc-inspired chunked diagram-to-circuit QNLP with IQP ansatz",
        "ansatz": "IQPAnsatz",
        "optimizer": "Adam",
        "num_layers": 4,
        "convergence_criteria": "early stopping with burn-in of 2 epochs and maximum of 20 epochs",
        "hyperparameters": {
          "task": "3-class sentiment classification",
          "classes": [
            "negative",
            "neutral",
            "positive"
          ],
          "chunk_max_length": 5,
          "temperature_tau": 0.1,
          "Kc": 3,
          "circuit_depth_D": 4,
          "learning_rate": 0.0005,
          "batch_size": 9,
