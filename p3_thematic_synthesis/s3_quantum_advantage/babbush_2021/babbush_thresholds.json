  "budget_seconds": 604800,
  "budget_label": "1 week — used as practical cap on T_star for viability",

  "default_S": 1000,
  "default_regime": "lower_bound",
  "default_tQ_s": 0.017,
  "default_tC_s": 33e-9,

  "_verdict_rules": {
    "_guidance": "Babbush's paper message: focus BEYOND quadratic. Quadratic is essentially infeasible under realistic assumptions; cubic is borderline; quartic+ is viable. Two conditions must BOTH hold: (1) M must exceed M_min (advantage possible), (2) T_star must fit in runtime budget.",
    "quadratic": {
      "default_verdict": "fails",
      "reasoning_template": "Babbush Eq. (5): quadratic advantage requires M > {M_min:.0e}. Even if met, crossover T* = {T_star} under S={S}. Paper's central claim is that quadratic speedups are not viable under error correction."
    },
    "cubic": {
      "default_verdict": "potentially_viable",
      "reasoning_template": "Babbush Eq. (5): cubic requires M > {M_min}. If reported M in [{M_min}, M_max(budget)] and within budget, viable."
    },
    "quartic": {
      "default_verdict": "likely_viable",
      "reasoning_template": "Babbush Eq. (5): quartic M_min = {M_min} is easy to meet; T_star = {T_star} fits typical budgets."
    },
    "exponential": {
      "default_verdict": "viable",
      "reasoning_template": "Exponential speedup escapes the polynomial-crossover argument."
    },
    "logarithmic": {
      "default_verdict": "likely_viable",
      "reasoning_template": "Super-polynomial speedup comparable to exponential; beats the tQ/tC penalty."
    },
    "none_proven": {
      "default_verdict": "fails",
      "reasoning_template": "No proven speedup — Babbush framework requires a specific polynomial order d>=2."
    }
  },

