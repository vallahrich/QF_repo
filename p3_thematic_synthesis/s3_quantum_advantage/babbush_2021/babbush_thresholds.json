  "M_min_table_I_simulated_annealing_regime": {
    "_note": "From Table I (tQ=440ms, tC=7ns). Ratio tQ/tC = 6.29e7.",
    "quadratic": {
      "d": 2,
      "S_1": {"M_min": 63000000, "T_star_seconds": 27648000, "T_star_label": "320 days"},
