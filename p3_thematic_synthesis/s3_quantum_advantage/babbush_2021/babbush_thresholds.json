{
  "_citation": "Babbush, McClean, Newman, Gidney, Boixo, Neven. 'Focus beyond quadratic speedups for error-corrected quantum advantage.' PRX Quantum 2, 010103 (2021). arXiv:2011.04149",

  "fault_tolerance_model": {
    "architecture": "surface_code_superconducting",
    "code_distance": 30,
    "surface_cycle_us": 1.0,
    "toffoli_cycles_per_gate": 5.5,
    "t_gate_time_us": 170,
    "t_gate_time_note": "tG = 30 * 5.5 * 1us = 170us per Toffoli/CCZ (Eq. 6)",
    "alternative_ion_trap_tG_us": 17000
  },

  "quantum_primitive_time_lower_bound": {
    "formula": "tQ >= 170us * N",
    "min_qubits": 100,
    "tQ_lower_bound_ms": 17,
    "sa_example_N_512_ms": 440
  },

  "classical_primitive_time_bound": {
    "formula": "tC <= 330ps * N",
    "tC_upper_bound_ns": 33,
    "sa_example_N_512_ns": 7
  },

  "advantage_condition": {
    "equation": "Eq. (5): M > (tQ * S / tC)^(1/(d-1))",
    "breakeven_time": "T_star = tQ * (tQ * S / tC)^(1/(d-1))",
    "variables": {
      "M": "Number of calls to quantum primitive",
      "d": "Polynomial speedup order (2=quadratic, 3=cubic, 4=quartic)",
      "tQ": "Quantum primitive time",
      "tC": "Classical primitive time",
      "S": "Classical parallelism factor (Amdahl)"
    }
  },

  "classical_parallelism_scenarios": {
    "S_1": {"label": "single_core", "S": 1},
    "S_1e3": {"label": "typical_cluster_or_datacenter", "S": 1000},
    "S_1e6": {"label": "extreme_sa_like_problems", "S": 1000000}
  },

  "M_min_table_I_lower_bound_regime": {
    "_note": "From Table I (tQ=17ms, tC=33ns). M must be >= these values for advantage. Lower bound ratio tQ/tC = 5.15e5.",
