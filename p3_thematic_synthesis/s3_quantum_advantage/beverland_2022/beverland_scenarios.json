{
  "_citation": "Beverland, Kubica, Svore, et al. 'Assessing requirements to scale to practical quantum advantage.' arXiv:2211.07629 (2022). Microsoft Azure Quantum.",

  "_methodology": "Instead of one fixed threshold, sweeps a grid of hardware parameters (logical qubit count, gate time, physical error rate, code distance). For each (experiment × scenario) cell, re-runs the Babbush Eq. (5) crossover formula under that scenario's assumptions. Produces a Pareto frontier of verdicts. NOTE: Toffoli timing uses the Babbush (2021) approximation tG = d × 5.5 × t_cycle, NOT Beverland's own logical-time-step formula τ(d) = (4t_gate + 2t_meas) × d. The 5.5 coefficient is from Babbush Eq. (6) surface-code Toffoli factory analysis. This is a deliberate simplification for cross-scenario comparability.",

  "parameter_grid": {
    "qubit_counts": [1000, 10000, 100000, 1000000],
    "gate_times_us": [0.1, 1.0, 10.0],
    "physical_error_rates": [1e-3, 1e-4],
    "code_distances": [15, 21, 30, 45],
    "_note": "6 scenarios cover the most decision-relevant corners: near-term pessimistic to far-term optimistic."
  },

  "named_scenarios": {
    "near_term_pessimistic": {
      "label": "Near-term pessimistic (NISQ → early FT)",
      "qubit_count": 1000,
