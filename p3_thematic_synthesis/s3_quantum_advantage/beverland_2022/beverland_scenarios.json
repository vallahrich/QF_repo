      "physical_error_rate": 1e-3,
      "code_distance": 15,
      "toffoli_time_us": 825,
      "toffoli_time_note": "15 * 5.5 * 10 us = 825 us",
      "budget_seconds": 604800
    },
    "near_term_optimistic": {
      "label": "Near-term optimistic (early FT, superconducting)",
