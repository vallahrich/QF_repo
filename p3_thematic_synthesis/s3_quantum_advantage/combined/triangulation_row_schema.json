{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triangulation_row_v1.0",
  "title": "Triangulation Matrix Row",
  "description": "One row per (paper_id, experiment_id) in the combined triangulation matrix.",
  "type": "object",
  "required": [
    "paper_id",
    "experiment_id",
    "silo",
    "algorithm_family",
    "L1_benchmark_validity",
    "L2_practicality_crossover",
    "L3_fullstack_resource",
    "L4_finance_domain_realism",
    "L4_finance_source",
    "L5_nisq_veto",
    "L5_veto_applied",
    "raw_ronnow_2014",
    "raw_hoefler_2023",
    "raw_babbush_2021",
    "raw_beverland_2022",
    "raw_chakrabarti_2021",
    "raw_dalzell_2023",
    "raw_stilck_franca_2021",
    "consensus_verdict",
    "pre_veto_consensus",
    "layers_scored",
    "layers_total",
    "disagreement_score",
    "disagreement_reason"
  ],
  "properties": {
    "paper_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "silo": {"type": "string"},
    "algorithm_family": {"type": "string"},

    "L1_benchmark_validity": {"$ref": "#/$defs/layerVerdict"},
    "L2_practicality_crossover": {"$ref": "#/$defs/layerVerdict"},
    "L2_merge_disagreement": {
      "type": "boolean",
      "description": "True iff Hoefler 2023 and Babbush 2021 returned different scored verdicts (both must be scored). Surfaces hidden disagreement masked by the L2 min-merge. Added 2026-05-02; optional for backward compatibility with rows produced before this date."
    },
    "L3_fullstack_resource": {"$ref": "#/$defs/layerVerdict"},
    "L4_finance_domain_realism": {"$ref": "#/$defs/layerVerdict"},
    "L4_finance_source": {
      "type": "string",
      "enum": ["chakrabarti_2021", "dalzell_2023", "none"]
    },
    "L5_nisq_veto": {"$ref": "#/$defs/layerVerdict"},
    "L5_veto_applied": {"type": "boolean"},

    "raw_ronnow_2014": {"$ref": "#/$defs/layerVerdict"},
    "raw_hoefler_2023": {"$ref": "#/$defs/layerVerdict"},
    "raw_babbush_2021": {"$ref": "#/$defs/layerVerdict"},
    "raw_beverland_2022": {"$ref": "#/$defs/layerVerdict"},
    "raw_chakrabarti_2021": {"$ref": "#/$defs/layerVerdict"},
    "raw_dalzell_2023": {"$ref": "#/$defs/layerVerdict"},
    "raw_stilck_franca_2021": {"$ref": "#/$defs/layerVerdict"},

    "consensus_verdict": {
      "type": "string",
      "enum": [
        "unanimous_viable",
        "low_coverage_viable",
        "majority_viable",
        "split",
        "majority_fails",
        "low_coverage_fails",
        "unanimous_fails",
        "insufficient_data"
      ]
    },
    "pre_veto_consensus": {
      "type": "string",
      "enum": [
        "unanimous_viable",
        "low_coverage_viable",
        "majority_viable",
        "split",
        "majority_fails",
        "low_coverage_fails",
        "unanimous_fails",
        "insufficient_data"
      ]
    },
    "layers_scored": {"type": "integer", "minimum": 0, "maximum": 4},
    "layers_total": {"type": "integer", "minimum": 0, "maximum": 4},
    "disagreement_score": {"type": "number", "minimum": 0, "maximum": 1},
    "disagreement_reason": {"type": "string"}
  },
  "$defs": {
    "layerVerdict": {
      "type": "string",
      "enum": [
        "viable",
        "likely_viable",
        "potentially_viable",
        "conditional",
        "fails",
        "not_applicable",
        "insufficient_data",
        "missing"
      ]
    }
  }
}
