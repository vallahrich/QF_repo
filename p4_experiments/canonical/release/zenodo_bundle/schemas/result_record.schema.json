{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-finance.local/p4/result_record.schema.json",
  "title": "P4 Result Record",
  "description": "One row r(u) for a primary experimental unit u = (problem instance, method implementation, hardware profile, epsilon, accounting mode).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unit_id",
    "paper_id",
    "experiment_id",
    "label",
    "silo",
    "algorithm_family",
    "method_implementation",
    "instance",
    "hardware_profile",
    "epsilon",
    "accounting_mode",
    "paper_claimed",
    "measured",
    "metric",
    "classical_ref",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "unit_id": {
      "type": "string",
      "description": "Deterministic hash of (label, instance_id, hardware_profile, epsilon, accounting_mode)."
    },
    "paper_id": {"type": "string"},
    "experiment_id": {"type": "string"},
    "label": {
      "type": "string",
      "enum": ["SD1", "SD10", "SD11", "SD12", "SD13", "SD14", "SD15", "SD16", "SD2", "SD3", "SD4", "SD5", "SD6", "SD7", "SD8", "SD9", "SF1", "SF2", "SM1", "SM2", "SM3", "SM4", "SM5", "SM6", "SM7", "SM8", "SP1", "SP2", "SP3", "SQ1", "SQ10", "SQ11", "SQ12", "SQ13", "SQ14", "SQ15", "SQ16", "SQ17", "SQ18", "SQ19", "SQ2", "SQ20", "SQ21", "SQ22", "SQ23", "SQ24", "SQ25", "SQ26", "SQ27", "SQ28", "SQ29", "SQ3", "SQ30", "SQ31", "SQ32", "SQ4", "SQ5", "SQ6", "SQ7", "SQ8", "SQ9", "ST1", "ST2", "SX1", "SX2", "SX3", "SX4", "SX5", "SX6", "SX7", "SX8"],
      "description": "P4 experiment label from the active S2-backed canonical cohort."
    },
    "silo": {"type": "string"},
    "algorithm_family": {"type": "string"},
    "method_implementation": {
      "type": "object",
      "required": ["name", "source_path"],
      "properties": {
        "name": {"type": "string"},
        "source_path": {"type": "string"},
        "qiskit_version": {"type": "string"},
        "qdk_version": {"type": "string"}
      }
    },
    "instance": {
      "type": "object",
      "required": ["instance_id", "parameters"],
      "properties": {
        "instance_id": {"type": "string"},
        "parameters": {"type": "object"}
      }
    },
    "hardware_profile": {
      "type": "string",
      "enum": [
        "sc_e3_surface",
        "sc_e4_surface",
        "ti_e3_surface",
        "ti_e4_surface",
        "maj_e6_surface",
        "maj_e6_floquet"
      ]
    },
    "epsilon": {
      "type": "number",
      "enum": [0.001, 0.0001, 0.000001]
    },
    "accounting_mode": {
      "type": "string",
      "enum": ["bare", "full"],
      "description": "bare = circuit as-submitted; full = includes state preparation + oracle compilation."
    },
    "paper_claimed": {
      "type": "object",
      "description": "Resources as extracted from the paper in P3 (may be partial).",
      "properties": {
        "num_qubits": {"type": ["integer", "null"]},
        "circuit_depth": {"type": ["integer", "null"]},
        "t_count": {"type": ["integer", "null"]},
        "t_depth": {"type": ["integer", "null"]},
        "runtime_seconds": {"type": ["number", "null"]},
        "claimed_speedup": {"type": ["string", "null"]}
      }
    },
    "measured": {
      "type": "object",
      "required": ["logical_qubits", "t_count", "t_depth", "runtime_seconds"],
      "properties": {
        "logical_qubits": {"type": ["integer", "null"], "minimum": 0},
        "physical_qubits": {"type": ["integer", "null"]},
        "t_count": {"type": ["integer", "null"], "minimum": 0},
        "t_depth": {"type": ["integer", "null"], "minimum": 0},
        "t_depth_source": {
          "type": "string",
          "enum": ["rotationDepth", "logicalDepth-fallback", "unavailable"],
          "description": "Which QDK field the measured.t_depth value was sourced from. rotationDepth is the canonical P4 proxy per qdk_bridge._normalise_result."
        },
        "runtime_seconds": {"type": ["number", "null"], "minimum": 0},
        "rqops": {"type": ["number", "null"]},
        "raw_estimate": {
          "type": "object",
          "description": "Raw dict returned by qdk.qsharp.estimate for audit trail."
        },
        "status": {
          "type": "string",
          "enum": ["ok", "engine_failure"],
          "description": "Phase 6 canonical pipeline: 'engine_failure' when the per-cell wall-clock budget was exceeded or estimate raised an exception. Absent or 'ok' on a successful estimate."
        },
        "reason": {
          "type": ["string", "null"],
          "description": "Phase 6: structured reason string when status='engine_failure' (e.g. 'timeout_after_1800s', 'RuntimeError: ...')."
        },
        "wall_clock_seconds": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Phase 6: actual wall-clock spent in the child process before completion, timeout, or exception."
        }
      }
    },
    "metric": {
      "type": "object",
      "description": "Finance-relevant metric from statevector/noisy simulation. Only the canonical row (accounting_mode='bare', epsilon=1e-4) carries a populated metric; every other row sets status='bare_only_metric_design' and leaves value=null (documented in run_unit.py).",
      "properties": {
        "name": {"type": ["string", "null"]},
        "value": {"type": ["number", "null"]},
        "ci_low": {"type": ["number", "null"]},
        "ci_high": {"type": ["number", "null"]},
        "n_shots": {"type": ["integer", "null"]},
        "status": {
          "type": "string",
          "enum": ["measured", "bare_only_metric_design", "skipped_large_statevector"]
        }
      }
    },
    "classical_ref": {
      "type": "object",
      "description": "Best-available classical baseline on the same instance (field-literature default; §10.3).",
      "properties": {
        "algorithm_label": {"type": ["string", "null"]},
        "metric_value": {"type": ["number", "null"]},
        "wall_clock_seconds": {"type": ["number", "null"]},
        "source": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["created_utc", "qdk_version", "qiskit_version", "git_commit"],
      "properties": {
        "created_utc": {"type": "string", "format": "date-time"},
        "qdk_version": {"type": "string"},
        "qiskit_version": {"type": "string"},
        "git_commit": {"type": "string"},
        "preregistration_tag": {"type": "string"},
        "tag_migration_utc": {"type": "string", "format": "date-time"},
        "tag_migration_from": {"type": "string"},
        "operator": {"type": "string"}
      }
    }
  }
}
