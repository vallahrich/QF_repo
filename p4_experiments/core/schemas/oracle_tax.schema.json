{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-finance.local/p4/oracle_tax.schema.json",
  "title": "P4 Oracle Tax Aggregation Row",
  "description": "One aggregated tau(u) row per (unit_id, resource_axis). Built from paired bare/full result records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unit_id",
    "label",
    "silo",
    "hardware_profile",
    "epsilon",
    "resource_axis",
    "claimed",
    "measured_bare",
    "measured_full",
    "tau_vs_claim",
    "tau_vs_bare"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "unit_id": {"type": "string"},
    "label": {"type": "string", "enum": ["B3", "B4", "B5", "T3", "SD1", "SQ1", "SP1", "SP2", "SH1", "SM1", "SM2", "SM3", "SD2", "SD3", "SD4", "SQ2", "SQ3", "SQ4", "SP3", "SP4", "SM4", "SM5", "SM6", "SF1", "SR1", "ST1", "SX1", "SX2", "SD5", "SD6", "SD7", "SD8", "SD9", "SD10", "SD11", "SQ5", "SQ6", "SQ7", "SQ8", "SQ9", "SQ10", "SQ11", "SQ12", "SP5", "SP6", "SP7", "SM7", "SM8", "SM9", "SM10", "SM11", "SF2", "SF3", "SR2", "SX3", "SX4", "SQ13", "SQ14", "SQ15", "SP8", "SP9", "SM12", "SM13", "SM14", "SM15", "SD12", "SD13", "SD14", "SX5", "SX6", "SD15", "SD16", "SD17", "SM16", "SM17", "SM18", "SM19", "SP10", "SP11", "SP12", "SP13", "SQ16", "SQ17", "SQ18", "SQ19", "SQ20", "SQ21", "SQ22", "SQ23", "SX7", "SX8", "SX9"]},
    "silo": {"type": "string"},
    "hardware_profile": {"type": "string"},
    "epsilon": {"type": "number"},
    "resource_axis": {
      "type": "string",
      "enum": ["logical_qubits", "t_count", "t_depth", "runtime_seconds"]
    },
    "claimed": {"type": ["number", "null"]},
    "measured_bare": {"type": ["number", "null"]},
    "measured_full": {"type": ["number", "null"]},
    "tau_vs_claim": {
      "type": ["number", "null"],
      "description": "measured_full / claimed; null if claimed absent."
    },
    "tau_vs_bare": {
      "type": ["number", "null"],
      "description": "measured_full / measured_bare; always computable when both present."
    },
    "log10_tau_vs_claim": {"type": ["number", "null"]},
    "log10_tau_vs_bare": {"type": ["number", "null"]}
  }
}
