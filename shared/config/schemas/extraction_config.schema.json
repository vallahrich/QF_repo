{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-finance.local/schemas/extraction_config.schema.json",
  "title": "P2 Extraction Config",
  "type": "object",
  "required": ["default_model", "steps"],
  "properties": {
    "default_model": {"type": "string"},
    "fallback_model": {"type": "string"},
    "zotero_group_id": {"type": "string"},
    "obsidian_vault_path": {"type": "string"},
    "pdf_output_path": {"type": "string"},
    "markdown_output_path": {"type": "string"},
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "model", "prompt_file"],
        "properties": {
          "name": {"type": "string"},
          "model": {"type": "string"},
          "temperature": {"type": "number", "minimum": 0, "maximum": 2},
          "max_tokens": {"type": "integer", "minimum": 1},
          "prompt_file": {"type": "string"},
          "input_tokens": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
