{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-finance.local/schemas/phase3_inclusion.schema.json",
  "title": "Phase 3 Per-Silo Inclusion Manifest",
  "type": "object",
  "required": ["silo_code", "silo_folder", "papers"],
  "properties": {
    "silo_code": {"type": "string", "pattern": "^PD-[0-9]{2}$"},
    "silo_folder": {"type": "string"},
    "silo_tag": {"type": "string"},
    "total_papers_in_silo": {"type": "integer", "minimum": 0},
    "in_quantitative_scope": {"type": "integer", "minimum": 0},
    "in_thematic_scope": {"type": "integer", "minimum": 0},
    "tier_distribution": {"type": "object"},
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["paper_id"],
        "properties": {
          "paper_id": {"type": "string"},
          "in_quantitative_scope": {"type": "boolean"},
          "in_thematic_scope": {"type": "boolean"},
          "relevance_phase3": {"type": "string"},
          "has_quantitative_results": {"type": "boolean"},
          "source_type": {"type": "string"},
          "evaluation_type": {"type": "string"},
          "quantum_advantage_claim": {"type": "string"},
          "year": {"type": ["string", "integer", "null"]},
          "tier": {"type": "string"},
          "researcher_action": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
