{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-finance.local/schemas/phase3_text_readiness.schema.json",
  "title": "Phase 3 Per-Silo Text-Readiness Manifest",
  "type": "object",
  "required": ["silo", "silo_code", "papers"],
  "properties": {
    "silo": {"type": "string"},
    "silo_code": {"type": "string", "pattern": "^PD-[0-9]{2}$"},
    "total_assessed": {"type": "integer", "minimum": 0},
    "status_distribution": {"type": "object"},
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["paper_id", "status"],
        "properties": {
          "paper_id": {"type": "string"},
          "status": {"type": "string"},
          "reason": {"type": "string"},
          "file_size_kb": {"type": "number"},
          "sections_found": {"type": "integer", "minimum": 0},
          "cjk_density": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
