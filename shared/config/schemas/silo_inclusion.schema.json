{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-finance.local/schemas/silo_inclusion.schema.json",
  "title": "Phase 3 Silo Inclusion Registry",
  "type": "object",
  "required": ["version", "active_silos"],
  "properties": {
    "version": {"type": "string"},
    "date": {"type": "string"},
    "description": {"type": "string"},
    "active_silos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "folder", "status"],
        "properties": {
          "code": {"type": "string", "pattern": "^PD-[0-9]{2}$"},
          "folder": {"type": "string"},
          "status": {"type": "string", "enum": ["active"]},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "excluded_silos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "folder", "reason"],
        "properties": {
          "code": {"type": "string", "pattern": "^PD-[0-9]{2}$"},
          "folder": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "cross_cutting": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["folder", "reason"],
        "properties": {
          "folder": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
