{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-finance.local/schemas/tier_definitions.schema.json",
  "title": "Tier Definitions",
  "type": "object",
  "required": ["version", "tiers"],
  "properties": {
    "version": {"type": "string"},
    "description": {"type": "string"},
    "multi_assignment": {"type": "boolean"},
    "tiers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "research_steps": {"type": "array", "items": {"type": "string"}},
          "groups": {"type": "object"},
          "groups_source": {"type": "string"},
          "classification_guidance": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
