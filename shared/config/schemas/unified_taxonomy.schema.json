{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-finance.local/schemas/unified_taxonomy.schema.json",
  "title": "Unified Taxonomy",
  "description": "Single registry of problem-domain (PD) and solution-approach (SA) codes consumed by p1-p4.",
  "type": "object",
  "required": ["version", "topic_tags", "methodology_tags"],
  "properties": {
    "version": {"type": "string"},
    "description": {"type": "string"},
    "phase1_source": {"type": "string"},
    "topic_tags": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["code", "description"],
        "properties": {
          "code": {"type": "string", "pattern": "^PD-[0-9]{2}$"},
          "description": {"type": "string"},
          "slr_id": {"type": "string"},
          "silo_folder": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "excluded", "retracted", "merged"]},
          "excluded_reason": {"type": "string"},
          "retracted_reason": {"type": "string"},
          "retracted_date": {"type": "string"},
          "merged_into": {"type": "string", "pattern": "^PD-[0-9]{2}$"}
        },
        "additionalProperties": true
      }
    },
    "methodology_tags": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["code", "description"],
        "properties": {
          "code": {"type": "string", "pattern": "^SA-[0-9]{2}$"},
          "description": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "excluded", "retracted", "merged"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
